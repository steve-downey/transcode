# Write OUTPUT, a header defining BENCHMARK_GIT_COMMIT as the commit being
# built (`git describe --always --dirty`), or "" when git or the repository is
# unavailable.  Runs as a script at every build, not at configure time, so the
# value follows checkouts and edits; configure_file rewrites OUTPUT only when
# its content changes, so the fixture recompiles only when the commit does.
#
# Usage: cmake -DGIT_EXECUTABLE=... -DSOURCE_DIR=... -DOUTPUT=... -P git_describe.cmake

set(commit "")
if(GIT_EXECUTABLE)
    execute_process(
        COMMAND "${GIT_EXECUTABLE}" describe --always --dirty --abbrev=12
        WORKING_DIRECTORY "${SOURCE_DIR}"
        OUTPUT_VARIABLE described
        OUTPUT_STRIP_TRAILING_WHITESPACE
        ERROR_QUIET
        RESULT_VARIABLE result
    )
    if(result EQUAL 0)
        set(commit "${described}")
    endif()
endif()

file(
    WRITE "${OUTPUT}.in"
    "// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
// Generated by benchmark/git_describe.cmake at build time; do not edit.

#ifndef BENCHMARK_BENCHMARK_COMMIT_HPP
#define BENCHMARK_BENCHMARK_COMMIT_HPP

#define BENCHMARK_GIT_COMMIT \"${commit}\"

#endif // BENCHMARK_BENCHMARK_COMMIT_HPP
"
)
configure_file("${OUTPUT}.in" "${OUTPUT}" COPYONLY)
